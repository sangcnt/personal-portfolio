---
import "../styles/global.css";

const upworkUrl = "https://www.upwork.com/freelancers/~01a39c68ae5405aa7f";

const work = [
  {
    id: "knowledge",
    category: "Applied AI",
    title: "Building knowledge systems",
    description:
      "RAG and conversational products that connect language models to trusted business data.",
    tags: ["RAG", "FastAPI", "OpenAI"],
  },
  {
    id: "agents",
    category: "Automation",
    title: "Engineering agentic workflows",
    description:
      "Practical agents with clear boundaries, observable steps, and humans kept in control.",
    tags: ["AI Agents", "LangGraph", "APIs"],
  },
  {
    id: "platforms",
    category: "Product engineering",
    title: "Shipping full-stack platforms",
    description:
      "End-to-end web products with durable architecture, polished interfaces, and reliable operations.",
    tags: ["Laravel", "React", "AWS"],
  },
];

const stack = [
  {
    label: "Backend",
    tools: ["Laravel / PHP", "Python / FastAPI", "Node.js", "PostgreSQL"],
  },
  {
    label: "Frontend",
    tools: ["React", "Next.js", "TypeScript", "Design systems"],
  },
  {
    label: "Applied AI",
    tools: ["RAG", "AI Agents", "Chatbots", "OpenAI / Claude", "LangChain / LangGraph"],
  },
  {
    label: "Infrastructure",
    tools: ["AWS", "Docker", "CI / CD", "System design"],
  },
];

const faqs = [
  {
    question: "What kind of work are you open to?",
    answer:
      "High-ownership full-stack projects, backend architecture, AI-enabled product features, and longer-term technical partnerships. I’m most useful when the problem is real, the requirements are evolving, and reliable delivery matters.",
  },
  {
    question: "Can you own a product end to end?",
    answer:
      "Yes. I can move from requirements and architecture through backend, frontend, infrastructure, deployment, and production support. I also work comfortably inside an existing team when the scope needs a focused senior engineer.",
  },
  {
    question: "How do you communicate with remote clients?",
    answer:
      "Async by default, with concise written updates, visible decisions, and early flags for risks or trade-offs. Calls are useful when they unblock work; progress should not depend on meetings.",
  },
  {
    question: "How do you approach AI features?",
    answer:
      "As product engineering, not a demo. That means grounding, evaluation, failure handling, cost awareness, security, and clear limits around what the model should and should not decide.",
  },
];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Sang is a senior full-stack engineer with 10+ years of experience building reliable web applications and practical AI-powered features."
    />
    <meta name="theme-color" content="#fdfdfe" />
    <link rel="canonical" href="https://sangcnt.online/" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sangcnt.online/" />
    <meta property="og:title" content="Sang — Senior Full-Stack Engineer" />
    <meta
      property="og:description"
      content="Reliable web applications and practical AI features that actually work in production."
    />
    <meta property="og:image" content="https://sangcnt.online/og-v2.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Sang — Senior Full-Stack Engineer" />
    <meta
      name="twitter:description"
      content="Reliable web applications and practical AI features that actually work in production."
    />
    <meta name="twitter:image" content="https://sangcnt.online/og-v2.png" />
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("sang-theme");
        document.documentElement.dataset.theme = savedTheme === "dark" ? "dark" : "light";
      } catch {}
    </script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Sang",
        url: "https://sangcnt.online",
        jobTitle: "Senior Full-Stack Engineer",
        address: {
          "@type": "PostalAddress",
          addressLocality: "Ho Chi Minh City",
          addressCountry: "VN",
        },
        sameAs: [upworkUrl],
        knowsAbout: [
          "Laravel",
          "PHP",
          "Python",
          "FastAPI",
          "React",
          "Next.js",
          "TypeScript",
          "RAG systems",
          "AI agents",
          "AWS",
          "PostgreSQL",
          "Docker",
        ],
      })}
    ></script>
    <title>Sang — Senior Full-Stack Engineer</title>
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="nav-shell">
      <div class="nav-pill">
        <a class="wordmark" href="#top" aria-label="Sang, home">
          <span class="wordmark-mark" aria-hidden="true">S</span>
          <span class="wordmark-text">sang<span>.dev</span></span>
        </a>

        <nav class="nav-links" aria-label="Primary navigation">
          <a href="#work" data-section="work">Work</a>
          <a href="#about" data-section="about">About</a>
          <a href="#stack" data-section="stack">Stack</a>
          <a href="#contact" data-section="contact">Contact</a>
        </nav>

        <div class="nav-actions">
          <button class="theme-toggle" type="button" aria-label="Switch to dark theme">
            <span class="theme-light" aria-hidden="true">☼</span>
            <span class="theme-dark" aria-hidden="true">◐</span>
          </button>
          <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <main id="main-content">
      <section class="hero" id="top">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="particles" aria-hidden="true"></div>

        <div class="hero-content">
          <p class="hero-eyebrow">Senior Full-Stack Engineer</p>
          <h1>
            <span>Systems.</span>
            <span>Products. <em>AI.</em></span>
          </h1>
          <p class="hero-subtitle">
            From architecture to production. Built to stay reliable.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#work">View work</a>
            <a class="button button-secondary" href={upworkUrl} target="_blank" rel="noreferrer">
              Let’s talk
            </a>
          </div>

          <div class="trust-line" aria-label="Upwork track record">
            <span><b>10+</b> years</span>
            <i></i>
            <span><b>100%</b> Job Success</span>
            <i></i>
            <span><b>Top Rated</b> on Upwork</span>
          </div>
        </div>
      </section>

      <div class="page-surface">
        <section class="site-section work-section" id="work" aria-labelledby="work-title">
          <div class="section-header">
            <h2 id="work-title">Selected work</h2>
            <span aria-hidden="true"></span>
          </div>

          <div class="work-grid">
            {work.map((item, index) => (
              <article class={`work-card work-card--${item.id}`}>
                <div class="work-visual" aria-hidden="true">
                  {item.id === "knowledge" && (
                    <div class="mockup mockup-chat">
                      <div class="mockup-top"><i></i><i></i><i></i><span>Knowledge workspace</span></div>
                      <div class="chat-shell">
                        <div class="chat-sidebar">
                          <b></b><span></span><span></span><span></span>
                          <small></small><small></small>
                        </div>
                        <div class="chat-main">
                          <div class="chat-title"><b></b><span></span></div>
                          <div class="chat-answer">
                            <i></i>
                            <p><span></span><span></span><span></span></p>
                          </div>
                          <div class="chat-sources"><span></span><span></span></div>
                          <div class="chat-input"></div>
                        </div>
                      </div>
                    </div>
                  )}

                  {item.id === "agents" && (
                    <div class="mockup mockup-flow">
                      <div class="mockup-top"><i></i><i></i><i></i><span>Workflow canvas</span></div>
                      <div class="flow-canvas">
                        <div class="flow-line line-a"></div>
                        <div class="flow-line line-b"></div>
                        <div class="flow-line line-c"></div>
                        <div class="flow-node node-a"><i>01</i><span></span><small></small></div>
                        <div class="flow-node node-b"><i>02</i><span></span><small></small></div>
                        <div class="flow-node node-c"><i>03</i><span></span><small></small></div>
                        <div class="flow-node node-d"><i>04</i><span></span><small></small></div>
                        <div class="flow-status">Running <b></b></div>
                      </div>
                    </div>
                  )}

                  {item.id === "platforms" && (
                    <div class="mockup mockup-dashboard">
                      <div class="mockup-top"><i></i><i></i><i></i><span>Operations dashboard</span></div>
                      <div class="dashboard-shell">
                        <aside><b></b><span></span><span></span><span></span><span></span></aside>
                        <div class="dashboard-main">
                          <div class="dashboard-heading"><span></span><button></button></div>
                          <div class="metric-row">
                            <div><small></small><b>98.6%</b><i></i></div>
                            <div><small></small><b>1.2s</b><i></i></div>
                            <div><small></small><b>24.8k</b><i></i></div>
                          </div>
                          <div class="chart">
                            <span style="height: 42%"></span><span style="height: 58%"></span>
                            <span style="height: 48%"></span><span style="height: 74%"></span>
                            <span style="height: 66%"></span><span style="height: 88%"></span>
                            <span style="height: 78%"></span><span style="height: 94%"></span>
                          </div>
                        </div>
                      </div>
                    </div>
                  )}
                </div>

                <div class="work-content">
                  <div class="work-meta">
                    <span>{item.category}</span>
                    <small>0{index + 1}</small>
                  </div>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                  <div class="work-footer">
                    <ul aria-label="Technologies">
                      {item.tags.map((tag) => <li>{tag}</li>)}
                    </ul>
                    <span class="case-study-status">Case study soon</span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="site-section about-section" id="about" aria-labelledby="about-title">
          <div class="section-header">
            <h2 id="about-title">About</h2>
            <span aria-hidden="true"></span>
          </div>

          <div class="about-grid">
            <aside class="about-aside">
              <h3>What I do</h3>
              <ul>
                <li>Turn complex requirements into clear, buildable systems.</li>
                <li>Move comfortably from backend architecture to product interface.</li>
                <li>Add AI where it creates real leverage, not theatre.</li>
              </ul>
            </aside>

            <div class="bio-card">
              <div class="bio-avatar" aria-hidden="true">S</div>
              <p>
                I’m Sang. Over 10+ years in software engineering, I’ve built and maintained web
                products across backend, frontend, cloud infrastructure, and now applied AI.
              </p>
              <p>
                I work best where product complexity, technical ownership, and reliable execution
                meet. I care about sensible architecture, direct communication, and software that
                still makes sense after the first release.
              </p>
              <p class="bio-emphasis">
                When the path is unclear, I make it concrete and keep the work moving.
              </p>
              <div class="bio-signoff">
                <span><b>Sang</b>Senior Full-Stack Engineer</span>
                <span>Ho Chi Minh City<br />Vietnam</span>
              </div>
            </div>

            <aside class="about-aside about-aside-right">
              <h3>How I work</h3>
              <ul>
                <li>Own outcomes end to end, not isolated tickets.</li>
                <li>Keep progress, risks, and trade-offs visible.</li>
                <li>Design inside real constraints and ship in useful increments.</li>
              </ul>
            </aside>
          </div>

          <div class="upwork-proof">
            <div class="upwork-logo" aria-hidden="true">up</div>
            <div>
              <small>Independent track record</small>
              <strong>58 jobs. 100% Job Success. Top Rated.</strong>
            </div>
            <a href={upworkUrl} target="_blank" rel="noreferrer">View Upwork profile <span>↗</span></a>
          </div>
        </section>

        <section class="site-section stack-section" id="stack" aria-labelledby="stack-title">
          <div class="section-header">
            <h2 id="stack-title">Core stack</h2>
            <span aria-hidden="true"></span>
          </div>

          <div class="stack-list">
            {stack.map((group, index) => (
              <article class="stack-row">
                <span class="stack-index">0{index + 1}</span>
                <h3>{group.label}</h3>
                <ul>
                  {group.tools.map((tool) => <li>{tool}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </section>

        <section class="site-section faq-section" id="faq" aria-labelledby="faq-title">
          <div class="section-header">
            <h2 id="faq-title">Good to know</h2>
            <span aria-hidden="true"></span>
          </div>

          <div class="faq-list">
            {faqs.map((faq, index) => (
              <details>
                <summary>
                  <span>0{index + 1}</span>
                  <strong>{faq.question}</strong>
                  <i aria-hidden="true"></i>
                </summary>
                <p>{faq.answer}</p>
              </details>
            ))}
          </div>
        </section>

        <section class="contact-section" id="contact">
          <div class="contact-glow" aria-hidden="true"></div>
          <p>Let’s work together</p>
          <h2>Serious product work.<br />Clear technical ownership.</h2>
          <span>
            Have a web product to build, a system to untangle, or an AI feature to put into
            production?
          </span>
          <a class="button button-primary" href={upworkUrl} target="_blank" rel="noreferrer">
            Message me on Upwork
          </a>
        </section>
      </div>
    </main>

    <footer>
      <div>
        <a class="wordmark footer-wordmark" href="#top">
          <span class="wordmark-mark" aria-hidden="true">S</span>
          <span class="wordmark-text">sang<span>.dev</span></span>
        </a>
        <p>© {new Date().getFullYear()} Sang. Senior Full-Stack Engineer.</p>
        <a href="#top">Back to top ↑</a>
      </div>
    </footer>

    <script is:inline>
      const root = document.documentElement;
      const themeButton = document.querySelector(".theme-toggle");
      const menuButton = document.querySelector(".menu-toggle");
      const nav = document.querySelector(".nav-pill");
      const navLinks = [...document.querySelectorAll(".nav-links a")];

      const updateThemeLabel = () => {
        const dark = root.dataset.theme === "dark";
        themeButton?.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", dark ? "#16141d" : "#fdfdfe");
      };

      updateThemeLabel();

      themeButton?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("sang-theme", next); } catch {}
        updateThemeLabel();
      });

      menuButton?.addEventListener("click", () => {
        const open = nav?.classList.toggle("menu-open") ?? false;
        menuButton.setAttribute("aria-expanded", String(open));
        menuButton.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      });

      navLinks.forEach((link) => link.addEventListener("click", () => {
        nav?.classList.remove("menu-open");
        menuButton?.setAttribute("aria-expanded", "false");
      }));

      if ("IntersectionObserver" in window) {
        const sections = ["work", "about", "stack", "contact"]
          .map((id) => document.getElementById(id))
          .filter(Boolean);
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            navLinks.forEach((link) => {
              link.toggleAttribute("aria-current", link.dataset.section === entry.target.id);
            });
          });
        }, { rootMargin: "-38% 0px -54%" });
        sections.forEach((section) => observer.observe(section));
      }
    </script>
  </body>
</html>
