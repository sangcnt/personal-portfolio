---
import "../styles/global.css";

const upworkUrl = "https://www.upwork.com/freelancers/~01a39c68ae5405aa7f";
const publicEmail = "";

const stackGroups = [
  {
    code: "BE",
    title: "Backend",
    description: "Robust APIs, clear domain logic, and systems designed to stay maintainable.",
    skills: ["Laravel / PHP", "Python / FastAPI", "Node.js", "PostgreSQL"],
  },
  {
    code: "FE",
    title: "Frontend",
    description: "Fast, accessible interfaces that make complex workflows feel simple.",
    skills: ["React", "Next.js", "TypeScript", "Design systems"],
  },
  {
    code: "AI",
    title: "Applied AI",
    description: "Practical AI features grounded in real data, evaluation, and production needs.",
    skills: ["RAG systems", "AI agents", "Chatbots", "LLM integration"],
  },
  {
    code: "OP",
    title: "Cloud & Systems",
    description: "Reliable delivery from architecture and infrastructure through deployment.",
    skills: ["AWS", "Docker", "System design", "CI / CD"],
  },
];

const focusAreas = [
  {
    number: "01",
    eyebrow: "Applied AI",
    title: "Knowledge systems",
    description:
      "RAG and conversational experiences that connect language models to trusted business data.",
    tags: ["RAG", "FastAPI", "LLM"],
  },
  {
    number: "02",
    eyebrow: "Automation",
    title: "Agentic workflows",
    description:
      "Human-centered agents and automations designed around clear boundaries and observable outcomes.",
    tags: ["Agents", "LangGraph", "APIs"],
  },
  {
    number: "03",
    eyebrow: "Product engineering",
    title: "Full-stack platforms",
    description:
      "End-to-end web products with thoughtful architecture, polished interfaces, and dependable operations.",
    tags: ["Laravel", "React", "AWS"],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Sang is a senior full-stack engineer with 10+ years of experience building reliable web applications and practical AI-powered features."
    />
    <meta name="theme-color" content="#f6f4ed" />
    <link rel="canonical" href="https://sangcnt.online/" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sangcnt.online/" />
    <meta property="og:title" content="Sang — Senior Full-Stack Engineer" />
    <meta
      property="og:description"
      content="Reliable web applications and practical AI features that actually work in production."
    />
    <meta property="og:image" content="https://sangcnt.online/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Sang — Senior Full-Stack Engineer" />
    <meta
      name="twitter:description"
      content="Reliable web applications and practical AI features that actually work in production."
    />
    <meta name="twitter:image" content="https://sangcnt.online/og.png" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Sang",
        url: "https://sangcnt.online",
        jobTitle: "Senior Full-Stack Engineer",
        address: {
          "@type": "PostalAddress",
          addressLocality: "Ho Chi Minh City",
          addressCountry: "VN",
        },
        sameAs: [upworkUrl],
        knowsAbout: [
          "Laravel",
          "PHP",
          "Python",
          "FastAPI",
          "React",
          "Next.js",
          "TypeScript",
          "RAG systems",
          "AI agents",
          "AWS",
          "PostgreSQL",
          "Docker",
        ],
      })}
    ></script>
    <title>Sang — Senior Full-Stack Engineer</title>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="shell nav-wrap">
        <a class="brand" href="#top" aria-label="Sang, home">
          <span class="brand-mark" aria-hidden="true">S</span>
          <span>Sang<span class="brand-dot">.</span></span>
        </a>

        <nav class="nav-links" aria-label="Primary navigation">
          <a href="#about">About</a>
          <a href="#stack">Stack</a>
          <a href="#projects">Projects</a>
        </nav>

        <a class="nav-cta" href="#contact">
          Let’s talk
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="top">
        <div class="shell hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">
              <span class="status-dot" aria-hidden="true"></span>
              Senior Full-Stack Engineer · Ho Chi Minh City
            </p>

            <h1>
              Full-stack engineering
              <span>built for the real world.</span>
            </h1>

            <p class="hero-lede">
              I’m Sang, a full-stack engineer with 10+ years of experience building reliable
              web applications and practical AI features that actually work in production.
            </p>

            <div class="hero-actions">
              <a class="button button-primary" href="#projects">
                View projects
                <span aria-hidden="true">↓</span>
              </a>
              <a class="button button-secondary" href="#contact">
                Start a conversation
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <aside class="hero-card" aria-label="Professional summary">
            <div class="hero-card-top">
              <span class="card-label">Engineering profile</span>
              <span class="availability">Available</span>
            </div>

            <div class="experience-lockup">
              <strong>10<span>+</span></strong>
              <p>years building and shipping software</p>
            </div>

            <div class="profile-lines">
              <div>
                <span>Specialties</span>
                <strong>Web platforms · Applied AI</strong>
              </div>
              <div>
                <span>Approach</span>
                <strong>Reliable · Pragmatic · Clear</strong>
              </div>
              <div>
                <span>Based in</span>
                <strong>Ho Chi Minh City, VN</strong>
              </div>
            </div>

            <div class="architecture-strip" aria-hidden="true">
              <span>Product</span>
              <i>→</i>
              <span>System</span>
              <i>→</i>
              <span>Ship</span>
            </div>
          </aside>
        </div>
      </section>

      <section class="proof" aria-label="Upwork track record">
        <div class="shell proof-grid">
          <div class="proof-intro">
            <span class="upwork-mark" aria-hidden="true">up</span>
            <p>Trusted by clients on Upwork</p>
          </div>
          <div class="proof-stat">
            <strong>100%</strong>
            <span>Job Success</span>
          </div>
          <div class="proof-stat">
            <strong>Top Rated</strong>
            <span>Upwork talent</span>
          </div>
          <div class="proof-stat">
            <strong>58</strong>
            <span>Total jobs</span>
          </div>
          <a class="proof-link" href={upworkUrl} target="_blank" rel="noreferrer">
            View profile
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <section class="section about" id="about">
        <div class="shell section-grid">
          <div class="section-heading">
            <span class="section-number">01</span>
            <p class="kicker">About</p>
            <h2>A senior partner, not just an extra pair of hands.</h2>
          </div>

          <div class="about-content">
            <p class="lead">
              I help teams turn complex requirements into dependable software — from backend
              architecture and responsive interfaces to AI-powered product features.
            </p>
            <div class="about-columns">
              <p>
                Over the past decade, I’ve worked across the full delivery lifecycle: clarifying
                product needs, designing systems, writing production code, deploying
                infrastructure, and supporting what ships.
              </p>
              <p>
                I value direct communication, sensible trade-offs, and solutions that remain easy
                to understand after the first release. The goal is useful software, delivered
                without unnecessary drama.
              </p>
            </div>

            <div class="principles">
              <div>
                <span>01</span>
                <strong>Think in outcomes</strong>
                <p>Technology choices follow the business problem.</p>
              </div>
              <div>
                <span>02</span>
                <strong>Build for change</strong>
                <p>Clear systems are easier to extend and operate.</p>
              </div>
              <div>
                <span>03</span>
                <strong>Communicate clearly</strong>
                <p>Progress, risks, and trade-offs stay visible.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section stack" id="stack">
        <div class="shell">
          <div class="section-title-row">
            <div>
              <span class="section-number">02</span>
              <p class="kicker">Core expertise</p>
              <h2>From product interface to production infrastructure.</h2>
            </div>
            <p>
              A broad technical range, grounded in years of hands-on delivery and system
              ownership.
            </p>
          </div>

          <div class="stack-grid">
            {stackGroups.map((group) => (
              <article class="stack-card">
                <span class="stack-code">{group.code}</span>
                <h3>{group.title}</h3>
                <p>{group.description}</p>
                <ul>
                  {group.skills.map((skill) => <li>{skill}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section projects" id="projects">
        <div class="shell">
          <div class="section-title-row">
            <div>
              <span class="section-number">03</span>
              <p class="kicker">Selected work</p>
              <h2>Case studies are on the way.</h2>
            </div>
            <p>
              Detailed project stories are being prepared. In the meantime, these are the kinds of
              systems I’m focused on building.
            </p>
          </div>

          <div class="project-grid">
            {focusAreas.map((project) => (
              <article class="project-card">
                <div class="project-visual" aria-hidden="true">
                  <span>{project.number}</span>
                  <div class="visual-orbit">
                    <i></i>
                    <b></b>
                  </div>
                </div>
                <div class="project-body">
                  <p class="project-eyebrow">{project.eyebrow}</p>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                  <div class="project-meta">
                    <ul aria-label="Technologies">
                      {project.tags.map((tag) => <li>{tag}</li>)}
                    </ul>
                    <span class="coming-soon">Case study soon</span>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <p class="project-note">
            Looking for relevant examples?
            <a href={upworkUrl} target="_blank" rel="noreferrer">Ask me on Upwork ↗</a>
          </p>
        </div>
      </section>

      <section class="section contact" id="contact">
        <div class="shell contact-panel">
          <div class="contact-copy">
            <span class="section-number light">04</span>
            <p class="kicker light">Let’s work together</p>
            <h2>Have a product to build or a hard problem to untangle?</h2>
            <p>
              Tell me what you’re working on, where things stand, and what a successful outcome
              looks like. I’ll respond with clear next steps.
            </p>
          </div>

          <div class="contact-actions">
            <a class="contact-primary" href={upworkUrl} target="_blank" rel="noreferrer">
              <span>
                <small>Best way to reach me</small>
                Message me on Upwork
              </span>
              <b aria-hidden="true">↗</b>
            </a>

            {publicEmail && (
              <a class="contact-secondary" href={`mailto:${publicEmail}`}>
                <span>
                  <small>Prefer email?</small>
                  {publicEmail}
                </span>
                <b aria-hidden="true">↗</b>
              </a>
            )}
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <a class="brand footer-brand" href="#top">
          <span class="brand-mark" aria-hidden="true">S</span>
          <span>Sang<span class="brand-dot">.</span></span>
        </a>
        <p>Senior Full-Stack Engineer · Ho Chi Minh City, Vietnam</p>
        <p>© {new Date().getFullYear()} Sang. Built with care.</p>
      </div>
    </footer>
  </body>
</html>
